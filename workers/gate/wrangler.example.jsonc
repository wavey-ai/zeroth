{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "example-zeroth-gate",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-05",
  "routes": [
    { "pattern": "example.com/private*", "zone_name": "example.com" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ZEROTH_ISSUER": "https://id.wavey.ai",
    "ZEROTH_CLIENT_ID": "example-web",
    "ZEROTH_PROTECTED_PREFIXES": "/private",
    "ZEROTH_ASSET_PREFIX": "/private"
  }
}
