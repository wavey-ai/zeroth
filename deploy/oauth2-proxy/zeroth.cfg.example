# Candidate integration for OAuth2 Proxy 7.15.6; see the dated HTML investigation
# in docs/. Configuration parsing was checked; live Zeroth login was not tested.
# Replace the example issuer, public app URL, domain, client ID, and upstream.
# Register this exact callback as a confidential Zeroth client's redirect URI.
# Supply OAUTH2_PROXY_CLIENT_SECRET and OAUTH2_PROXY_COOKIE_SECRET as secrets.
# The backend must only be reachable through this proxy.
provider = "oidc"
provider_display_name = "Zeroth"
oidc_issuer_url = "https://id.example.com"
oidc_enabled_signing_algs = ["ES256"]
client_id = "zeroth-proxy"
redirect_url = "https://app.example.com/oauth2/callback"
scope = "openid profile email offline_access"
code_challenge_method = "S256"
insecure_oidc_skip_nonce = false
insecure_oidc_skip_issuer_verification = false
insecure_oidc_allow_unverified_email = false

# This is an additional app admission rule. Enterprise connection policy must
# also be enforced by Zeroth; an email suffix does not prove Workspace tenancy.
email_domains = ["example.com"]
upstreams = ["http://127.0.0.1:8080/"]
http_address = "127.0.0.1:4180"

cookie_name = "__Host-zeroth_proxy"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_path = "/"
cookie_expire = "8h"
cookie_refresh = "5m"

# Strip the identity headers this proxy is configured to emit. This is not a
# blanket header scrub: the trusted ingress must also remove caller-supplied
# Authorization, X-Forwarded-Access-Token and X-Auth-Request-* if the app could
# interpret them. The app should trust only the agreed proxy identity headers.
# Do not forward issued provider or Zeroth tokens to the app by default.
skip_auth_strip_headers = false
pass_user_headers = true
pass_basic_auth = false
pass_access_token = false
pass_authorization_header = false
set_authorization_header = false
# X-Auth-Request-* are response headers for ingress auth_request mode. Direct
# proxy requests use X-Forwarded-User/Email; do not confuse those contracts.
set_xauthrequest = true

# Avoid recording callback codes in full request-URL access logs.
request_logging = false

# TLS terminates on a trusted ingress. If reverse_proxy is enabled there,
# restrict trusted proxy addresses and prevent clients bypassing that ingress.
reverse_proxy = false
skip_provider_button = true
